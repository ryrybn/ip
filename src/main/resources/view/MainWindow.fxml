<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nuknagnel.gui.MainWindow" spacing="8" styleClass="main-window">
    <padding>
        <Insets top="10" right="12" bottom="10" left="12"/>
    </padding>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" fitToHeight="true"
                HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" styleClass="chat-scroll-pane">
        <content>
            <VBox fx:id="dialogContainer" spacing="6" styleClass="dialog-container"/>
        </content>
    </ScrollPane>

    <HBox spacing="8" styleClass="input-bar">
        <TextField fx:id="userInput" promptText="Type a command..."
                   onAction="#handleUserInput" HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"/>
    </HBox>

</VBox>
