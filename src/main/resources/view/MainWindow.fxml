<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="nuknagnel.gui.MainWindow" spacing="10" styleClass="main-window">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <ScrollPane fx:id="scrollPane" fitToWidth="true" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="dialogContainer" spacing="10"/>
        </content>
    </ScrollPane>

    <HBox spacing="8">
        <TextField fx:id="userInput" promptText="Type a command..."
                   onAction="#handleUserInput" HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" text="Send" onAction="#handleUserInput"/>
    </HBox>

</VBox>
